@page "/catalogotalleres"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Constantes.RolAlumno)]

@inject IHomeProxy HomeProxy
@inject IToastService ToastService
@inject IInstructorProxy InstructorProxy
@inject NavigationManager NavigationManager

<h3 class="text-uppercase mt-4 mb-3"><b>Listado de Talleres</b></h3>

<div class="row">
    <div class="col">
        <label for="nombre" class="form-label">Nombre</label>
        <InputText @bind-Value="BusquedaRequest.Nombre" class="form-control" id="nombre" />
    </div>
    <div class="col">
        <label for="instructor" class="form-label">Instructor</label>
        <InputSelect id="instructor" class="form-select" @bind-Value="BusquedaRequest.InstructorId">
            <option>Todos</option>
            @foreach (var item in Instructores)
            {
                <option value="@item.Id">@item.Nombres</option>
            }
        </InputSelect>
    </div>
</div>
<div class="mt-4 row align-items-end">
    <div class="col">
        <label for="fechaInicio" class="form-label">Fecha Inicio</label>
        <InputDate @bind-Value="BusquedaRequest.FechaInicio" class="form-control" id="fechaInicio" />
    </div>
    <div class="col">
        <label for="fechaFin" class="form-label">Fecha fin</label>
        <InputDate @bind-Value="BusquedaRequest.FechaFin" class="form-control" id="fechaFin" />
    </div>
    <div class="col offset-3">
        <button type="button" class="btn btn-success text-black border-black w-100" @onclick="Hoy">Hoy</button>
    </div>
    <div class="col">
        <button type="button" class="btn btn-success text-black border-black w-100" @onclick="EstaSemana">Esta semana</button>
    </div>
    <div class="col">
        <button type="button" class="btn btn-success text-black border-black w-100" @onclick="EsteMes">Este mes</button>
    </div>
    <div class="col">
        <button type="button" class="btn btn-primary w-100" @onclick="OnSearch"><i class="bi bi-search me-1"></i>Buscar</button>
    </div>
</div>
<div class="justify-content-center mt-4 mb-5 row row-cols-sm-1 row-cols-xl-4 gap-4 g-1">
    @if (Talleres is { Count: > 0 })
    {
        @foreach (var item in Talleres)
        {
            <div class="col">
                <div class="tarjeta">
                    <div class="tarjeta-imagen">
                        @if (item.PortadaUrl is null)
                        {
                            <img alt="@item.Nombre"
                                 src="assets/images/sinimagen.jpeg" style="width: 19rem" />
                        }
                        else
                        {
                            <img alt="@item.Nombre"
                                 src="@item.PortadaUrl" style="width: 19rem" />
                        }
                        <div class="tarjeta-content text-center mt-3">
                            <h5>@item.Nombre</h5>
                            <div class="row p-3 justify-content-center">
                                <span class="bg-black w-auto informacion-taller">
                                    <i class="bi bi-calendar me-1 bg-info"></i> <label class="text-white">Día @item.FechaInicio</label>
                                </span>
                                <span class="mt-3 bg-black informacion-taller">
                                    <i class="bi bi-alarm-fill me-1 bg-success"></i> <label class="text-white">Hora @item.HoraInicio hrs</label>
                                </span>
                            </div>
                            <div class="mb-1">
                                <label class="text-black small">Instructor: @item.Instructor</label>
                            </div>
                            <button type="button" class="btn btn-warning text-black border-black" @onclick="() => InformacionTaller(item.Id)">Información</button>
                        </div>
                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <p class="text-danger-emphasis">Aun no se han publicado Talleres</p>
    }

</div>
<div class="row justify-content-center mb-3">
    <div class="col-auto d-flex align-items-center">
        <nav aria-label="Paginación">
            <ul class="pagination mb-0 flex-wrap">
                <li class="page-item @(IsFirstPage ? "disabled" : "")">
                    <button class="page-link" @onclick="PrevPage" aria-label="Anterior">Anterior</button>
                </li>

                @if (PagedResult?.TotalPages > 0)
                {
                    var visible = GetVisiblePages();
                    if (visible.Count > 0)
                    {
                        foreach (var entry in visible)
                        {
                            if (entry == null)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            else
                            {
                                var pageNum = entry.Value;
                                <li class="page-item @(pageNum == PagedResult.CurrentPage ? "active" : "")">
                                    <button class="page-link" @onclick="@(async () => await ChangePage(pageNum))">@pageNum</button>
                                </li>
                            }
                        }
                    }
                }

                <li class="page-item @(IsLastPage ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPage" aria-label="Siguiente">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
    <div class="col-auto d-flex align-items-center">
        <small class="text-muted">Página @PagedResult?.CurrentPage de @PagedResult?.TotalPages</small>
    </div>
</div>
<LoadingComponent IsLoading="IsLoading" />

@code {

    public bool IsLoading { get; set; }
    public PagedResult<TallerHomeDtoResponse> PagedResult { get; set; } = new PagedResult<TallerHomeDtoResponse>();
    public BusquedaTallerHomeRequest BusquedaRequest { get; set; } = new BusquedaTallerHomeRequest() { PageNumber = 1, PageSize = 10 };
    private ICollection<TallerHomeDtoResponse>? Talleres { get; set; }
    private ICollection<InstructorDtoResponse> Instructores { get; set; } = new List<InstructorDtoResponse>();

    private int MaxPageButtons { get; } = 10;

    private bool IsFirstPage => PagedResult?.CurrentPage <= 1;
    private bool IsLastPage => PagedResult == null || PagedResult.CurrentPage >= PagedResult.TotalPages;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;

            PagedResult = new PagedResult<TallerHomeDtoResponse>()
            {
                CurrentPage = BusquedaRequest.PageNumber,
                RowsPerPage = BusquedaRequest.PageSize
            };

            await OnSearch();

            Instructores = await InstructorProxy.ListAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnSearch()
    {
        try
        {
            IsLoading = true;
            var response = await HomeProxy.ListarTalleresHomeAsync(BusquedaRequest);
            Talleres = response.Data;

            if (Talleres is not null)
            {
                PagedResult.Results = Talleres;
                PagedResult.RowCount = Talleres.Count;
                PagedResult.TotalPages = response.TotalPages;
                PagedResult.CurrentPage = BusquedaRequest.PageNumber;
                PagedResult.RowsPerPage = BusquedaRequest.PageSize;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || (PagedResult?.TotalPages > 0 && page > PagedResult.TotalPages)) return;
        BusquedaRequest.PageNumber = page;
        PagedResult.CurrentPage = page;
        await OnSearch();
    }

    private async Task PrevPage()
    {
        if (IsFirstPage) return;
        await ChangePage(PagedResult.CurrentPage - 1);
    }

    private async Task NextPage()
    {
        if (IsLastPage) return;
        await ChangePage(PagedResult.CurrentPage + 1);
    }

    private async Task ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e?.Value?.ToString(), out var newSize))
        {
            BusquedaRequest.PageSize = newSize;
            BusquedaRequest.PageNumber = 1;
            await OnSearch();
        }
    }

    private async Task FilasPorPagina()
    {
        BusquedaRequest.PageNumber = PagedResult.CurrentPage;
        BusquedaRequest.PageSize = PagedResult.RowsPerPage;
        await OnSearch();
    }
    private List<int?> GetVisiblePages()
    {
        var pages = new List<int?>();

        if (PagedResult == null || PagedResult.TotalPages <= 0)
            return pages;

        int total = PagedResult.TotalPages;
        int current = Math.Max(1, PagedResult.CurrentPage);
        int max = MaxPageButtons;

        if (total <= max)
        {
            for (int i = 1; i <= total; i++) pages.Add(i);
            return pages;
        }

        int half = max / 2;
        int start = current - half + 1;
        if (start < 1) start = 1;
        int end = start + max - 1;
        if (end > total)
        {
            end = total;
            start = total - max + 1;
        }

        if (start > 1)
        {
            pages.Add(1);
            if (start > 2)
            {
                pages.Add(null);
            }
        }

        for (int i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        if (end < total)
        {
            if (end < total - 1)
            {
                pages.Add(null);
            }
            pages.Add(total);
        }

        return pages;
    }

    private async Task PaginaCambiada()
    {
        IsLoading = true;
        BusquedaRequest.PageNumber = PagedResult.CurrentPage;
        BusquedaRequest.PageSize = PagedResult.RowsPerPage;

        await OnSearch();
    }

    private void Hoy()
    {
        BusquedaRequest.FechaInicio = DateOnly.FromDateTime(DateTime.Today);
        BusquedaRequest.FechaFin = DateOnly.FromDateTime(DateTime.Today);
    }

    private void EstaSemana()
    {
        BusquedaRequest.FechaInicio = DateOnly.FromDateTime(DateTime.Today);
        BusquedaRequest.FechaFin = DateOnly.FromDateTime(DateTime.Today).AddDays(7);
    }

    private void EsteMes()
    {
        BusquedaRequest.FechaInicio = DateOnly.FromDateTime(DateTime.Today); ;
        BusquedaRequest.FechaFin = DateOnly.FromDateTime(DateTime.Today).AddMonths(1);
    }

    private void InformacionTaller(int id)
    {
        NavigationManager.NavigateTo($"/Detalle/{id}");
    }
}